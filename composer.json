{
  "name": "maximilliangroupinc/starcache",
  "description": "Deterministic cache orchestration engine for WordPress. Auto-detects Redis, Memcached, Memcache; provides context-aware full-page caching, fragment caching, Varnish integration, version-based invalidation, and CSS/JS minification. Multisite-aware.",
  "type": "wordpress-muplugin",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "MaximillianGroup (Max Barrett)",
      "email": "maximilliangroup@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "StarCache\\": ""
    }
  },
  "autoload-dev": {
    "psr-4": {
      "StarCache\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "squizlabs/php_codesniffer": "^3.9",
    "phpstan/phpstan": "^2.0"
  },
  "scripts": {
    "test": "./vendor/bin/phpunit --configuration phpunit.xml --testdox",
    "lint": "./vendor/bin/phpcs --standard=phpcs.xml",
    "analyze": "./vendor/bin/phpstan analyse --configuration=phpstan.neon"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
