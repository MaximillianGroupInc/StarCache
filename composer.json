{
  "name": "maximilliangroupinc/starcache",
  "description": "Advanced WordPress MU-Plugin caching library: Redis, Memcached, OPcache, Varnish, query caching, asset minification, and multisite support.",
  "type": "wordpress-muplugin",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "MaximillianGroup (Max Barrett)",
      "email": "maximilliangroup@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "StarCache\\": ""
    }
  },
  "autoload-dev": {
    "psr-4": {
      "StarCache\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "scripts": {
    "test": "phpunit --testdox tests/"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
